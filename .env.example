# Node-RED MCP Server Configuration
# Copy this file to .env and fill in your Node-RED credentials.

# Node-RED Admin API URL.
# When Node-RED runs as the Home Assistant add-on it is typically reachable
# through the same NGINX proxy as Home Assistant itself, e.g.:
#     https://your-ha-host/nodered-api
NODERED_URL=https://your-ha-host/nodered-api

# Node-RED Admin API credentials (HTTP Basic auth).
NODERED_USERNAME=your_nodered_user
NODERED_PASSWORD=your_nodered_password

# Optional: HTTP server settings (only used by ha-mcp-nodered-web).
# MCP_HOST=127.0.0.1   # default; set to 0.0.0.0 to expose to a network
# MCP_PORT=8086
# MCP_SECRET_PATH=/mcp

# Optional: client tuning.
# NODERED_TIMEOUT=30
# LOG_LEVEL=INFO
